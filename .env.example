# Copy with:  node infra/init-env.mjs   (fills every change-me value with a random secret)
# Never commit the real .env.

# Oracle: SYS/SYSTEM password of the one Oracle server
ORACLE_PASSWORD=change-me

# One database (PDB) and user per site. The branch user has the same name in each branch PDB
# ("same service, different location"); only the database and password differ.
DC_DB_PASSWORD=change-me
BRANCH_A_DB_PASSWORD=change-me
BRANCH_B_DB_PASSWORD=change-me

# WSO2 API Manager (both branch gateways). WSO2_ENCRYPTION_KEY: exactly 32 hex characters.
WSO2_ADMIN_PASSWORD=change-me
WSO2_ENCRYPTION_KEY=change-me
# WSO2 users that own the applications. Scopes are granted by the owner's role:
# the listener's user may get branch_x:sync, the dashboard's user only branch_x:read.
WSO2_LISTENER_PASSWORD=change-me
WSO2_DASHBOARD_PASSWORD=change-me
